{
  "name": "work-order",
  "version": "1.0.0",
  "description": "A gs-ui template project",
  "author": "zhangsan <zhangsan@example.com>",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development vue-cli-service serve",
    "start": "npm run serve",
    "serve": "vue-cli-service serve",
    "mock:api": "node mock/server.js",
    "dev:mock": "concurrently \"npm run mock:api\" \"npm run dev\"",
    "mock": "vue-cli-service mock --mode mock",
    "build": "vue-cli-service build --mode development",
    "build:prod": "vue-cli-service build --mode production",
    "lint": "vue-cli-service lint",
    "sasslint": "sass-lint -v -q -o ./report/sasslint.html -f html",
    "test:unit": "vue-cli-service test:unit"
  },
  "dependencies": {
    "@components/side-nav": "file:./stubs/side-nav",
    "@gs-ui/gs-ui": "file:./stubs/gs-ui",
    "axios": "^0.18.0",
    "keymirror": "^0.1.1",
    "lodash": "^4.18.1",
    "moment": "^2.24.0",
    "regenerator-runtime": "^0.14.1",
    "vue": "^2.5.17",
    "vue-router": "^3.0.1",
    "vue-slicksort": "^1.1.3",
    "vuex": "^3.0.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.0.0",
    "@playwright/test": "^1.60.0",
    "@vue/cli-plugin-babel": "^3.1.1",
    "@vue/cli-plugin-eslint": "^3.1.5",
    "@vue/cli-plugin-unit-mocha": "^3.1.1",
    "@vue/cli-service": "^3.1.4",
    "@vue/eslint-config-standard": "^4.0.0",
    "@vue/test-utils": "^1.0.0-beta.20",
    "babel-eslint": "^10.0.1",
    "babel-loader": "^8.4.1",
    "babel-plugin-component": "^1.1.1",
    "cache-loader": "^4.1.0",
    "chai": "^4.1.2",
    "concurrently": "^8.2.0",
    "cross-env": "^5.2.0",
    "css-loader": "^3.6.0",
    "eslint": "^5.8.0",
    "eslint-plugin-vue": "^5.0.0-0",
    "express": "^4.21.0",
    "file-loader": "^4.3.0",
    "lint-staged": "^7.2.2",
    "playwright": "^1.60.0",
    "postcss-loader": "^3.0.0",
    "sass": "^1.32.0",
    "sass-loader": "^7.0.1",
    "url-loader": "^2.3.0",
    "vue-loader": "^15.11.1",
    "vue-style-loader": "^4.1.3",
    "vue-template-compiler": "^2.5.17"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/essential",
      "@vue/standard"
    ],
    "rules": {
      "semi": [
        "error",
        "always"
      ],
      "comma-dangle": [
        "off"
      ],
      "space-before-function-paren": [
        "error",
        {
          "anonymous": "always",
          "named": "never"
        }
      ]
    },
    "parserOptions": {
      "parser": "babel-eslint"
    }
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],
  "lint-staged": {
    "*.js": [
      "vue-cli-service lint",
      "git add"
    ],
    "*.vue": [
      "vue-cli-service lint",
      "git add"
    ],
    "*.s+(a|c)ss": [
      "sass-lint -v -q"
    ]
  }
}
